#!/bin/bash
# OpenVPN up/down hook (root). Hívás: ovpn-dns <run-dir> <log-fájl>, a típus a $script_type env-ből.
# Az SSTP is ezt használja: a mvpn a pppd naplójából kiolvasott DNS-eket OpenVPN-formában adja át
# (env -i script_type=up dev=pppN foreign_option_N="dhcp-option DNS <cím>"), így a mentés/visszaállítás közös.
# A szerver által küldött DNS-t minden hálózati szolgáltatásra beállítja (mint a wg-quick), down-nál visszaállítja.
# A szerver által küldött értékeket nem eval-oljuk: printenv + szigorú formátum-ellenőrzés.
# script_type=check: csak kiírja az elfogadott DNS/DOMAIN értékeket (teszteléshez), semmit nem állít.
# bash 3.2 kompatibilis.
export PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export LC_ALL=C   # bájt-alapú regex/tr/sed, a felhasználó locale-jától függetlenül
RUN="$1"
LOG="$2"
[ -d "$RUN" ] || exit 0
log() { printf '%s\n' "$*" >>"$LOG"; }
# Az üzenetek nyelve a futási könyvtár lang fájljából (a mvpn írja a --lang alapján); hiányzó vagy ismeretlen: angol.
MVPN_LANG=en
[ -f "$RUN/lang" ] && [ ! -L "$RUN/lang" ] && [ "$(head -c 3 "$RUN/lang")" = "hu" ] && MVPN_LANG=hu
msg() { if [ "$MVPN_LANG" = hu ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

is_ipv4() { [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; }
is_ipv6() {
  [[ "$1" =~ ^[0-9A-Fa-f:]+$ ]] || return 1
  [[ "$1" =~ [0-9A-Fa-f] ]] || return 1
  [[ "$1" =~ :.*: ]]
}
is_dns() { is_ipv4 "$1" || is_ipv6 "$1"; }
is_domain() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]]; }

parse_options() {
  local i=1 o v
  DNS=(); DOMS=()
  while o=$(printenv "foreign_option_$i"); do
    case "$o" in
      "dhcp-option DNS "*)    v="${o#dhcp-option DNS }";    is_dns "$v" && DNS+=("$v") ;;
      "dhcp-option DOMAIN "*) v="${o#dhcp-option DOMAIN }"; is_domain "$v" && DOMS+=("$v") ;;
    esac
    i=$((i + 1))
  done
}

case "$script_type" in
  check)
    parse_options
    for v in "${DNS[@]}"; do echo "DNS $v"; done
    for v in "${DOMS[@]}"; do echo "DOMAIN $v"; done
    ;;
  up)
    if [[ "$dev" =~ ^(utun|ppp)[0-9]+$ ]]; then
      printf '%s\n' "$dev" >"$RUN/iface"
    else
      log "▶ [mvpn] $(msg "unexpected interface name, not recorded" "váratlan interfésznév, nem rögzítjük")"
    fi
    if is_ipv4 "$ifconfig_local"; then
      printf '%s\n' "$ifconfig_local" >"$RUN/ip"
    fi
    parse_options
    [ ${#DNS[@]} -eq 0 ] && { log "▶ [mvpn] $(msg "the server sent no DNS" "a szerver nem küldött DNS-t")"; exit 0; }
    # Ha már van mentés (pl. újracsatlakozás down nélkül), azt megtartjuk: különben a VPN DNS-ét mentenénk el eredetiként.
    BACKUP=1
    if [ -f "$RUN/dns-backup" ]; then BACKUP=0; else : >"$RUN/dns-backup"; fi
    networksetup -listallnetworkservices | tail -n +2 | sed 's/^\*//' | while IFS= read -r svc; do
      if [ "$BACKUP" = 1 ]; then
        cur=$(networksetup -getdnsservers "$svc" | tr '\n' ' ')
        case "$cur" in *"aren't any"*) cur="Empty" ;; esac
        curs=$(networksetup -getsearchdomains "$svc" | tr '\n' ' ')
        case "$curs" in *"aren't any"*) curs="Empty" ;; esac
        printf '%s\t%s\t%s\n' "$svc" "$cur" "$curs" >>"$RUN/dns-backup"
      fi
      log "\$ networksetup -setdnsservers \"$svc\" ${DNS[*]}"
      networksetup -setdnsservers "$svc" "${DNS[@]}"
      if [ ${#DOMS[@]} -gt 0 ]; then
        log "\$ networksetup -setsearchdomains \"$svc\" ${DOMS[*]}"
        networksetup -setsearchdomains "$svc" "${DOMS[@]}"
      fi
    done
    ;;
  down)
    [ -f "$RUN/dns-backup" ] || exit 0
    # A mentett listák szándékosan szóközök mentén bomlanak szét; a set -f miatt nincs glob-kifejtés.
    set -f
    while IFS=$'\t' read -r svc dns doms; do
      [ -n "$svc" ] || continue
      log "\$ networksetup -setdnsservers \"$svc\" $dns"
      networksetup -setdnsservers "$svc" $dns
      networksetup -setsearchdomains "$svc" $doms
    done <"$RUN/dns-backup"
    set +f
    rm -f "$RUN/dns-backup"
    ;;
esac
exit 0
