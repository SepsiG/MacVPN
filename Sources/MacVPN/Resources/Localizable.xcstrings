{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ · Missing tool" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Hiányzó eszköz"
          }
        }
      }
    },
    "%@ · system VPN (not created by MacVPN)" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · rendszer VPN (nem a MacVPN hozta létre)"
          }
        }
      }
    },
    "%@-log.txt" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-naplo.txt"
          }
        }
      }
    },
    "%@: connection failed" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: sikertelen csatlakozás"
          }
