    "VPN tools" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN eszközök"
          }
        }
      }
    },
    "You can now drag the app to the Trash. The Homebrew packages were kept (brew uninstall openvpn wireguard-tools strongswan sstp-client)." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az app most áthúzható a Kukába. A Homebrew csomagok megmaradtak (brew uninstall openvpn wireguard-tools strongswan sstp-client)."
          }
        }
      }
    },
    "You can remove the L2TP / Cisco profiles in System Settings → General → Device Management." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az L2TP / Cisco profilokat a Rendszerbeállítások → Általános → Eszközkezelés alatt távolíthatod el."
          }
        }
      }
    },
    "You have to remove the installed profile yourself in the Profiles pane that opens." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A telepített profilt a megnyíló Profilok panelen neked kell eltávolítanod."
          }
        }
      }
    },
    "~/Library/Application Support/MacVPN and the MacVPN Keychain items" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/Library/Application Support/MacVPN és a MacVPN Keychain-bejegyzései"
          }
        }
      }
    },
    "Shared secret (PSK)" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Közös kulcs (PSK)"
          }
        }
      }
    },
    "Password (optional, if not saved in macOS)" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelszó (nem kötelező, ha nincs elmentve a macOS-ben)"
          }
        }
      }
    },
    "Stored in the MacVPN keychain and passed to macOS when connecting. Needed when macOS cannot read the shared secret on its own (\"incorrect user shared secret\")." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A MacVPN kulcskarikájában tárolódik, és csatlakozáskor a macOS megkapja. Akkor kell, ha a macOS magától nem tudja kiolvasni a közös kulcsot („incorrect user shared secret”)."
          }
        }
      }
    },
    "Saved" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentve"
          }
        }
      }
    },
    "Forget saved secrets" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentett titkok törlése"
          }
        }
      }
    },
    "Server certificate" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szervertanúsítvány"
          }
        }
      }
    },
    "System CA" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendszer CA"
          }
        }
      }
    },
    "Custom CA file" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saját CA fájl"
          }
        }
      }
    },
    "No verification" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs ellenőrzés"
          }
        }
      }
    },
    "Uses the CA certificates of Homebrew's OpenSSL, not the macOS Keychain. For a company CA, choose a custom CA file." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Homebrew OpenSSL CA-tanúsítványait használja, nem a macOS kulcskarikát. Céges CA-hoz válaszd a saját CA fájlt."
          }
        }
      }
    },
    "Certificates loaded: %lld" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betöltött tanúsítványok: %lld"
          }
        }
      }
    },
    "No CA certificate loaded" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs betöltött CA tanúsítvány"
          }
        }
      }
    },
    "Choose PEM File…" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PEM fájl kiválasztása…"
          }
        }
      }
    },
    "The server's certificate is not verified. Anyone between you and the server can impersonate it and capture your login. Use this only for testing." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver tanúsítványát semmi nem ellenőrzi. Bárki, aki közted és a szerver között van, kiadhatja magát a szervernek, és megszerezheti a bejelentkezési adataidat. Csak tesztelésre használd."
          }
        }
      }
    },
    "Use the server's DNS" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver DNS-ének használata"
          }
        }
      }
    },
    "The file contains no PEM certificate (-----BEGIN CERTIFICATE-----). Convert a binary (DER) .cer file to PEM first." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fájlban nincs PEM tanúsítvány (-----BEGIN CERTIFICATE-----). Bináris (DER) .cer fájlt előbb alakíts PEM-re."
          }
        }
      }
    },
    "Port" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Port"
          }
        }
      }
    },
    "The password is stored in the Keychain. Use user@domain instead of DOMAIN\\user." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jelszó a kulcskarikába kerül. DOMAIN\\user helyett user@domain formát használj."
          }
        }
      }
    },
    "Launch at Login" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indítás bejelentkezéskor"
          }
        }
      }
    },
    "Open Login Items Settings…" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bejelentkezési elemek beállításai…"
          }
        }
      }
    },
    "Could not turn on launch at login" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült bekapcsolni az indítást bejelentkezéskor"
          }
        }
      }
    },
    "Could not turn off launch at login" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült kikapcsolni az indítást bejelentkezéskor"
          }
        }
      }
    },
    "MacVPN could not be removed from the login items. You can remove it in System Settings → General → Login Items." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A MacVPN-t nem sikerült eltávolítani a bejelentkezési elemek közül. A Rendszerbeállítások → Általános → Bejelentkezési elemek alatt távolíthatod el."
          }
        }
      }
    },
    "Only Offer Updates Published at Least 24 Hours Ago" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak a legalább 24 órája megjelent frissítések felajánlása"
          }
        }
      }
    },
    "The previous update did not complete" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az előző frissítés nem fejeződött be"
          }
        }
      }
    },
    "The update stopped with an error (%@). The installed version was kept. Details: %@" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frissítés hibával leállt (%@). A telepített verzió megmaradt. Részletek: %@"
          }
        }
      }
    },
    "The update was cancelled because MacVPN did not quit within 30 seconds. The installed version was not changed; you can try again from the menu." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frissítés megszakadt, mert a MacVPN 30 másodpercen belül nem lépett ki. A telepített verzió nem változott; a menüből újra megpróbálhatod."
          }
        }
      }
    },
    "Version %@ was published less than 24 hours ago. It will be offered later, as \"Only Offer Updates Published at Least 24 Hours Ago\" is on." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ verzió kevesebb mint 24 órája jelent meg. Később kerül felajánlásra, mert be van kapcsolva a „Csak a legalább 24 órája megjelent frissítések felajánlása” beállítás."
          }
        }
      }
    }
