# routeros-v6-wiki.ovpn after MacVPN import (files inlined, credentials file dropped)
client
dev tun
proto tcp-client
remote 192.0.2.1
port 1194
nobind
persist-key
persist-tun
tls-client
pull
remote-cert-tls server
ns-cert-type server
<ca>
-----BEGIN CERTIFICATE-----
MIIDdzCCAl+gAwIBAgIIFakeRouterOSCaCertificate0000000000000000000
-----END CERTIFICATE-----
</ca>
<cert>
-----BEGIN CERTIFICATE-----
MIIDfjCCAmagAwIBAgIIFakeRouterOSClientCertificate00000000000000
-----END CERTIFICATE-----
</cert>
<key>
-----BEGIN RSA PRIVATE KEY-----
Proc-Type: 4,ENCRYPTED
DEK-Info: AES-256-CBC,00112233445566778899AABBCCDDEEFF

MIIEpAIBAAKCAQEAFakeLegacyEncryptedRouterOSKey000000000000000000
-----END RSA PRIVATE KEY-----
</key>
verb 3
mute 10
cipher AES-128-CBC
auth sha1
auth-user-pass
route-delay 2
resolv-retry infinite
route 192.168.88.0 255.255.255.0
