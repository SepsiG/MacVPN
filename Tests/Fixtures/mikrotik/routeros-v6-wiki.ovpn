# OpenVPN client for a MikroTik RouterOS v6 server (wiki style, separate files)
client
dev tun
proto tcp-client
remote 192.0.2.1
port 1194
nobind
persist-key
persist-tun
tls-client
pull
remote-cert-tls server
ns-cert-type server
ca ca.crt
cert client.crt
key client.key
verb 3
mute 10
cipher AES-128-CBC
auth sha1
auth-user-pass auth.cfg
route-delay 2
resolv-retry infinite
route 192.168.88.0 255.255.255.0
