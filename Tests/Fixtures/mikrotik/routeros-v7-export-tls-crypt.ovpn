client
dev tun
proto udp
remote vpn.example.net 1194
nobind
persist-key
persist-tun
tls-client
remote-cert-tls server
verb 4
mute 10
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
data-ciphers-fallback AES-256-CBC
auth SHA256
auth-user-pass
auth-nocache
askpass
redirect-gateway def1 ipv6 bypass-dhcp
<ca>
-----BEGIN CERTIFICATE-----
MIIDdzCCAl+gAwIBAgIIFakeRouterOSCaCertificate0000000000000000000
-----END CERTIFICATE-----
</ca>
<cert>
-----BEGIN CERTIFICATE-----
MIIDfjCCAmagAwIBAgIIFakeRouterOSClientCertificate00000000000000
-----END CERTIFICATE-----
</cert>
<key>
-----BEGIN ENCRYPTED PRIVATE KEY-----
MIIFHzBJBgkqhkiG9w0BBQ0wPDAbBgkqhkiG9w0BBQwwDgQIFakeEncryptedKey00
-----END ENCRYPTED PRIVATE KEY-----
</key>
<tls-crypt>
#
# 2048 bit OpenVPN static key
#
-----BEGIN OpenVPN Static key V1-----
00000000000000000000000000000000
-----END OpenVPN Static key V1-----
</tls-crypt>
