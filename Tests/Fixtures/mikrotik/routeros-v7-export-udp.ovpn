client
dev tun
remote vpn.example.net 1194 udp
tun-mtu 1500
remote-cert-tls server
data-ciphers AES-256-GCM:AES-192-GCM:AES-128-GCM:AES-256-CBC:AES-192-CBC:AES-128-CBC
auth SHA256
auth-user-pass
auth-nocache
resolv-retry infinite
nobind
persist-key
persist-tun
verb 3
mute 10
redirect-gateway def1
<ca>
-----BEGIN CERTIFICATE-----
MIIDdzCCAl+gAwIBAgIIFakeRouterOSCaCertificate0000000000000000000
-----END CERTIFICATE-----
</ca>
<cert>
-----BEGIN CERTIFICATE-----
MIIDfjCCAmagAwIBAgIIFakeRouterOSClientCertificate00000000000000
-----END CERTIFICATE-----
</cert>
<key>
-----BEGIN ENCRYPTED PRIVATE KEY-----
MIIFHzBJBgkqhkiG9w0BBQ0wPDAbBgkqhkiG9w0BBQwwDgQIFakeEncryptedKey00
-----END ENCRYPTED PRIVATE KEY-----
</key>
