client
dev tun
proto udp4
remote vpn.example.net 1194 udp
remote 198.51.100.7 1194 tcp4-client
remote-random
resolv-retry infinite
connect-retry 5 60
nobind
float
persist-key
persist-tun
pull
tls-client
tls-version-min 1.2
remote-cert-tls server
verify-x509-name router.example.net name
ns-cert-type server
cipher aes-256-cbc
data-ciphers AES-256-GCM:AES-128-GCM:aes-256-cbc
auth SHA1
auth-user-pass
auth-retry nointeract
auth-nocache
askpass
reneg-sec 0
keepalive 10 60
ping-timer-rem
explicit-exit-notify 2
tun-mtu 1500
mssfix 1450
topology subnet
route-nopull
route 192.168.88.0 255.255.255.0 vpn_gateway
route 10.10.0.0 255.255.0.0 vpn_gateway 10
route 203.0.113.0 255.255.255.0 net_gateway
route-delay 2
route-method exe
dhcp-option DNS 192.168.88.1
dhcp-option DOMAIN lan.example
setenv opt block-outside-dns
block-outside-dns
script-security 1
comp-lzo no
verb 3
mute 20
<ca>
-----BEGIN CERTIFICATE-----
MIIDdzCCAl+gAwIBAgIIFakeRouterOSCaCertificate0000000000000000000
-----END CERTIFICATE-----
</ca>
<cert>
-----BEGIN CERTIFICATE-----
MIIDfjCCAmagAwIBAgIIFakeRouterOSClientCertificate00000000000000
-----END CERTIFICATE-----
</cert>
<key>
-----BEGIN ENCRYPTED PRIVATE KEY-----
MIIFHzBJBgkqhkiG9w0BBQ0wPDAbBgkqhkiG9w0BBQwwDgQIFakeEncryptedKey00
-----END ENCRYPTED PRIVATE KEY-----
</key>
