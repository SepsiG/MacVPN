dev tun
persist-tun
persist-key
data-ciphers-fallback AES-256-CBC
auth SHA256
client
resolv-retry infinite
remote vpn.example.com 1194 udp4
lport 0
verify-x509-name "C=NL, ST=Zuid-Holland, L=Middelharnis, O=Example, CN=vpn.example.com" subject
remote-cert-tls server
auth-user-pass
auth-nocache
static-challenge "Enter OTP token:" 1
<ca>
-----BEGIN CERTIFICATE-----
MIIDSzCCAjOgAwIBAgIUFakeOPNsenseCaCertificateNotReal000000000000000
MIIDSzCCAjOgAwIBAgIUFakeOPNsenseCaCertificateNotReal111111111111111
-----END CERTIFICATE-----
</ca>
<cert>
-----BEGIN CERTIFICATE-----
MIIDVDCCAjygAwIBAgIBAjANBgkqhkiG9w0BAQsFakeOPNsenseClientCertNotReal0
MIIDVDCCAjygAwIBAgIBAjANBgkqhkiG9w0BAQsFakeOPNsenseClientCertNotReal1
-----END CERTIFICATE-----
</cert>
<key>
-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBFakeOPNsenseKeyNotReal0
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBFakeOPNsenseKeyNotReal1
-----END PRIVATE KEY-----
</key>
<tls-auth>
#
# 2048 bit OpenVPN static key
#
-----BEGIN OpenVPN Static key V1-----
00000000000000000000000000000000
11111111111111111111111111111111
22222222222222222222222222222222
33333333333333333333333333333333
-----END OpenVPN Static key V1-----
</tls-auth>
key-direction 1
