dev tun
persist-tun
persist-key
proto tcp4-client
data-ciphers-fallback AES-256-GCM
auth SHA512
client
resolv-retry infinite
reneg-sec 0
remote vpn.example.com 443 tcp4
remote 203.0.113.30 443 tcp4
lport 0
verify-x509-name "CN=vpn.example.com" subject
remote-cert-tls server
auth-user-pass
compress lz4-v2
pull-filter ignore "redirect-gateway"
route 10.20.30.0 255.255.255.0
block-outside-dns
