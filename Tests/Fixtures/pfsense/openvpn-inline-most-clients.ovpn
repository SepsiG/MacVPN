dev tun
persist-tun
persist-key
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
data-ciphers-fallback AES-256-CBC
auth SHA256
tls-client
client
resolv-retry infinite
remote 203.0.113.20 1194 udp4
setenv opt block-outside-dns
nobind
verify-x509-name "vpn-server-cert" name
auth-user-pass
remote-cert-tls server
explicit-exit-notify

<ca>
-----BEGIN CERTIFICATE-----
MIIDSzCCAjOgAwIBAgIUFakepfSenseCaCertificateNotReal000000000000000
MIIDSzCCAjOgAwIBAgIUFakepfSenseCaCertificateNotReal111111111111111
-----END CERTIFICATE-----
</ca>
<cert>
-----BEGIN CERTIFICATE-----
MIIDVDCCAjygAwIBAgIBAjANBgkqhkiG9w0BAQsFakepfSenseClientCertNotReal0
MIIDVDCCAjygAwIBAgIBAjANBgkqhkiG9w0BAQsFakepfSenseClientCertNotReal1
-----END CERTIFICATE-----
</cert>
<key>
-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBFakepfSenseKeyNotReal0
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBFakepfSenseKeyNotReal1
-----END PRIVATE KEY-----
</key>
key-direction 1
<tls-auth>
#
# 2048 bit OpenVPN static key
#
-----BEGIN OpenVPN Static key V1-----
00000000000000000000000000000000
11111111111111111111111111111111
22222222222222222222222222222222
33333333333333333333333333333333
-----END OpenVPN Static key V1-----
</tls-auth>
