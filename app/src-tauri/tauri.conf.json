{
  "productName": "MacVPN",
  "mainBinaryName": "MacVPN",
  "version": "1.5.0",
  "identifier": "local.macvpn",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "menu",
        "create": false,
        "title": "MacVPN",
        "url": "index.html",
        "width": 330,
        "height": 360,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "shadow": true,
        "focus": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "assetProtocol": { "enable": false },
      "capabilities": ["main", "prompt", "pairing", "credentials", "vault", "backup", "restore-fresh"]
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "MacVPN"
  }
}
