{
  "name": "macvpn-ui",
  "version": "2.0.5",
  "private": true,
  "description": "MacVPN Tauri UI (Svelte + TypeScript + Vite)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build": "npm run check && vite build",
    "test": "node --test src/lib/",
    "tauri": "TAURI_APP_PATH=../src-tauri TAURI_FRONTEND_PATH=. tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.3",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.4",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "allowScripts": {
    "fsevents": false
  }
}
