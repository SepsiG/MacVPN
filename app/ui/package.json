{
  "name": "macvpn-ui",
  "version": "2.1.15",
  "private": true,
  "description": "MacVPN Tauri UI (Svelte + TypeScript + Vite)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build": "npm run check && vite build",
    "test": "node --test src/lib/",
    "tauri": "TAURI_APP_PATH=../src-tauri TAURI_FRONTEND_PATH=. tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@tauri-apps/cli": "2.12.5",
    "@tsconfig/svelte": "5.0.9",
    "@types/node": "26.6.6",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "allowScripts": {
    "fsevents": false
  }
}
