{
  "schema": [
    {
      "name": "catalog_admin_keys",
      "sql": "CREATE TABLE catalog_admin_keys(\n        key_id TEXT PRIMARY KEY,\n        role TEXT NOT NULL CHECK(role IN ('primary','backup')),\n        seed BLOB NOT NULL,\n        created TEXT NOT NULL\n    )",
      "table": "catalog_admin_keys",
      "type": "table"
    },
    {
      "name": "catalog_items",
      "sql": "CREATE TABLE catalog_items(\n        local_id TEXT PRIMARY KEY,\n        catalog_id TEXT NOT NULL REFERENCES catalog_subscriptions(catalog_id) ON DELETE CASCADE,\n        item_id TEXT NOT NULL,\n        kind TEXT NOT NULL CHECK(kind IN ('root','folder','connection')),\n        color TEXT NULL,\n        slot_id TEXT NULL,\n        provided_secrets TEXT NOT NULL DEFAULT '',\n        config_hash TEXT NULL,\n        meta_hash TEXT NULL,\n        pending_removal INTEGER NOT NULL DEFAULT 0,\n        profile_outdated INTEGER NOT NULL DEFAULT 0,\n        UNIQUE(catalog_id, item_id, kind)\n    )",
      "table": "catalog_items",
      "type": "table"
    },
    {
      "name": "catalog_publications",
      "sql": "CREATE TABLE catalog_publications(\n        catalog_id TEXT PRIMARY KEY,\n        json TEXT NOT NULL,\n        team_key BLOB NOT NULL\n    )",
      "table": "catalog_publications",
      "type": "table"
    },
    {
      "name": "catalog_slots",
      "sql": "CREATE TABLE catalog_slots(\n        catalog_id TEXT NOT NULL REFERENCES catalog_subscriptions(catalog_id) ON DELETE CASCADE,\n        slot_id TEXT NOT NULL,\n        name TEXT NOT NULL,\n        credential_id TEXT NULL REFERENCES credentials(id) ON DELETE SET NULL,\n        PRIMARY KEY(catalog_id, slot_id)\n    )",
      "table": "catalog_slots",
      "type": "table"
    },
    {
      "name": "catalog_subscriptions",
      "sql": "CREATE TABLE catalog_subscriptions(\n        catalog_id TEXT PRIMARY KEY,\n        json TEXT NOT NULL,\n        team_key BLOB NOT NULL,\n        bearer BLOB NULL,\n        publisher_key BLOB NULL,\n        successor_key BLOB NULL\n    )",
      "table": "catalog_subscriptions",
      "type": "table"
    },
    {
      "name": "connections",
      "sql": "CREATE TABLE connections(\n        id TEXT PRIMARY KEY,\n        kind TEXT NOT NULL,\n        meta_json TEXT NOT NULL,\n        config BLOB NOT NULL,\n        folder_id TEXT NULL REFERENCES folders(id) ON DELETE SET NULL,\n        color TEXT NULL,\n        position INTEGER NOT NULL\n    )",
      "table": "connections",
      "type": "table"
    },
    {
      "name": "control_clients",
      "sql": "CREATE TABLE control_clients(id TEXT PRIMARY KEY, json TEXT NOT NULL)",
      "table": "control_clients",
      "type": "table"
    },
    {
      "name": "credential_links",
      "sql": "CREATE TABLE credential_links(\n        item_id TEXT PRIMARY KEY,\n        credential_id TEXT NOT NULL REFERENCES credentials(id) ON DELETE RESTRICT\n    )",
      "table": "credential_links",
      "type": "table"
    },
    {
      "name": "credentials",
      "sql": "CREATE TABLE credentials(\n        id TEXT PRIMARY KEY,\n        name TEXT NOT NULL UNIQUE,\n        username TEXT NOT NULL,\n        password BLOB NULL,\n        created TEXT NOT NULL,\n        updated TEXT NOT NULL\n    )",
      "table": "credentials",
      "type": "table"
    },
    {
      "name": "folders",
      "sql": "CREATE TABLE folders(\n        id TEXT PRIMARY KEY,\n        parent_id TEXT NULL REFERENCES folders(id) ON DELETE CASCADE,\n        name TEXT NOT NULL,\n        color TEXT NULL,\n        position INTEGER NOT NULL,\n        collapsed INTEGER NOT NULL DEFAULT 0\n    )",
      "table": "folders",
      "type": "table"
    },
    {
      "name": "meta",
      "sql": "CREATE TABLE meta(key TEXT PRIMARY KEY, value TEXT)",
      "table": "meta",
      "type": "table"
    },
    {
      "name": "pins",
      "sql": "CREATE TABLE pins(id TEXT PRIMARY KEY, position INTEGER NOT NULL)",
      "table": "pins",
      "type": "table"
    },
    {
      "name": "ranking",
      "sql": "CREATE TABLE ranking(id TEXT PRIMARY KEY, json TEXT NOT NULL)",
      "table": "ranking",
      "type": "table"
    },
    {
      "name": "secrets",
      "sql": "CREATE TABLE secrets(connection_id TEXT, field TEXT, value BLOB, PRIMARY KEY(connection_id, field))",
      "table": "secrets",
      "type": "table"
    },
