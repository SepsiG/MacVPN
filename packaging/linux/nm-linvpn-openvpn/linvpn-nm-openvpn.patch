+/* LinVPN: (decision 8) the extra vpn.data keys, passed to OpenVPN itself so that it merges the profile's and the
+ * server's routing options as it does on macOS. Every value is checked with the same rules as LinVPN's Rust side;
+ * anything else fails the connection. */
+static gboolean
+linvpn_invalid (GError **error, const char *key)
+{
+	g_set_error (error, NM_VPN_PLUGIN_ERROR, NM_VPN_PLUGIN_ERROR_BAD_ARGUMENTS,
+	             _("property “%s” invalid or not supported"), key);
+	return FALSE;
+}
+
+/* ^[A-Za-z0-9 _.:/-]{1,64}$ */
+static gboolean
+linvpn_text_ok (const char *s, gsize len)
+{
+	gsize i;
+
+	if (len < 1 || len > 64)
+		return FALSE;
+	for (i = 0; i < len; i++) {
+		if (!g_ascii_isalnum (s[i]) && !NM_IN_SET (s[i], ' ', '_', '.', ':', '/', '-'))
+			return FALSE;
+	}
+	return TRUE;
+}
+
+/* ^[0-9a-f-]{36}$ */
+static gboolean
+linvpn_uuid_ok (const char *s)
+{
+	gsize i;
+
+	if (!s || strlen (s) != 36)
+		return FALSE;
+	for (i = 0; i < 36; i++) {
+		if (!g_ascii_isdigit (s[i]) && !NM_IN_SET (s[i], 'a', 'b', 'c', 'd', 'e', 'f', '-'))
+			return FALSE;
+	}
+	return TRUE;
+}
+
+static gboolean
+linvpn_args_add (GPtrArray *args, NMSettingVpn *s_vpn, int *verb, GError **error)
+{
+	const char *tmp;
+	guint i, n;
+
+	*verb = -1;
+	tmp = nm_setting_vpn_get_data_item (s_vpn, NM_OPENVPN_KEY_LINVPN_REDIRECT_GATEWAY);
+	if (tmp) {
+		gs_strfreev char **flags = g_strsplit (tmp, " ", 0);
+
+		args_add_strv (args, "--redirect-gateway");
+		for (i = 0, n = 0; flags[i]; i++) {
+			if (!flags[i][0])
+				continue;
+			if (   ++n > 8
+			    || !NM_IN_STRSET (flags[i], "def1", "ipv6", "!ipv4", "bypass-dhcp", "bypass-dns",
+			                      "local", "autolocal", "block-local"))
+				return linvpn_invalid (error, NM_OPENVPN_KEY_LINVPN_REDIRECT_GATEWAY);
+			args_add_strv (args, flags[i]);
+		}
+	}
+
+	/* "<ignore|accept|reject> <text>" per line, the text optionally in double quotes */
+	tmp = nm_setting_vpn_get_data_item (s_vpn, NM_OPENVPN_KEY_LINVPN_PULL_FILTER);
+	if (tmp) {
+		gs_strfreev char **lines = g_strsplit (tmp, "\n", 0);
+
+		for (i = 0, n = 0; lines[i]; i++) {
+			char *text;
+			gsize len;
+
+			if (!lines[i][0])
+				continue;
+			text = strchr (lines[i], ' ');
+			if (++n > 16 || !text)
+				return linvpn_invalid (error, NM_OPENVPN_KEY_LINVPN_PULL_FILTER);
+			*text++ = '\0';
+			len = strlen (text);
+			if (len >= 2 && text[0] == '"' && text[len - 1] == '"') {
+				text[len - 1] = '\0';
+				text++;
+				len -= 2;
+			}
+			if (   !NM_IN_STRSET (lines[i], "ignore", "accept", "reject")
+			    || !linvpn_text_ok (text, len))
+				return linvpn_invalid (error, NM_OPENVPN_KEY_LINVPN_PULL_FILTER);
+			args_add_strv (args, "--pull-filter", lines[i], text);
+		}
+	}
+
+	tmp = nm_setting_vpn_get_data_item (s_vpn, NM_OPENVPN_KEY_LINVPN_ROUTE_NOPULL);
+	if (tmp) {
+		if (!nm_streq (tmp, "yes"))
+			return linvpn_invalid (error, NM_OPENVPN_KEY_LINVPN_ROUTE_NOPULL);
+		args_add_strv (args, "--route-nopull");
+	}
+
+	tmp = nm_setting_vpn_get_data_item (s_vpn, NM_OPENVPN_KEY_LINVPN_VERB);
+	if (tmp) {
+		if (!(tmp[0] >= '0' && tmp[0] <= '4' && tmp[1] == '\0'))
+			return linvpn_invalid (error, NM_OPENVPN_KEY_LINVPN_VERB);
+		*verb = tmp[0] - '0';
+	}
+	return TRUE;
+}
