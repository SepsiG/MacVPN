[Unit]
Description=LinVPN log reader (one request)
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/libexec/linvpn/linvpn-logd
StandardInput=socket
StandardOutput=journal
StandardError=journal
DynamicUser=yes
SupplementaryGroups=systemd-journal
RuntimeMaxSec=20
# One instance per request (at most 16 at a time, linvpn-logd.socket): journalctl's output is capped at 32 MiB and
# the selection at 1 MiB; the process, its reader thread and journalctl.
MemoryMax=384M
TasksMax=16
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# PrivateNetwork leaves path-bound AF_UNIX sockets reachable: the caller's, the system bus (NetworkManager's
# ActiveConnections, read-only properties) and the journal's stdout stream.
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Only its own processes (itself and journalctl) in /proc, and no /proc/sys or other kernel files.
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
